<+><div style=\"position: absolute; top: 10px; right: 10px;\">\r\n    <span>Пользователь: {{ user_login }}</span>\r\n    <a href=\"{% url 'logout' %}\" style=\"margin-left: 10px;\">Выйти</a>\r\n</div>\r\n<!DOCTYPE html>\r\n<html lang=\"ru\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Терминал оформления заказов</title>\r\n    <style>\r\n        * { margin: 0; padding: 0; box-sizing: border-box; touch-action: manipulation; user-select: none; }\r\n        body { font-family: Arial; background: #000; color: white; height: 100vh; overflow: hidden; }\r\n\r\n        #screensaver {\r\n            width: 100vw; height: 100vh;\r\n            background: linear-gradient(135deg, #1a1a1a, #2d2d2d);\r\n            display: flex; justify-content: center; align-items: center;\r\n            font-size: 4em; cursor: pointer; flex-direction: column;\r\n            position: fixed; top: 0; left: 0; z-index: 1000;\r\n        }\r\n\r\n        #app { display: none; height: 100vh; flex-direction: column; }\r\n        .step-container { flex: 1; display: none; flex-direction: column; }\r\n        .step-header { text-align: center; font-size: 2.5em; padding: 30px; background: #333; border-bottom: 3px solid #555; }\r\n\r\n        /* Навигация */\r\n        .navigation {\r\n            display: flex;\r\n            justify-content: space-between;\r\n            padding: 25px 30px;\r\n            background: #333;\r\n            border-top: 3px solid #555;\r\n        }\r\n\r\n        .nav-btn {\r\n            padding: 20px 40px;\r\n            font-size: 1.5em;\r\n            background: #555;\r\n            color: white;\r\n            border: none;\r\n            border-radius: 15px;\r\n            cursor: pointer;\r\n            min-width: 150px;\r\n        }\r\n\r\n        .nav-btn:disabled {\r\n            background: #333;\r\n            color: #666;\r\n            cursor: not-allowed;\r\n        }\r\n\r\n        .nav-btn.confirm {\r\n            background: #4CAF50;\r\n        }\r\n\r\n        /* Экран успеха */\r\n        #successScreen {\r\n            position: fixed;\r\n            top: 0;\r\n            left: 0;\r\n            width: 100%;\r\n            height: 100%;\r\n            background: rgba(0, 0, 0, 0.9);\r\n            display: none;\r\n            justify-content: center;\r\n            align-items: center;\r\n            z-index: 2000;\r\n            flex-direction: column;\r\n            text-align: center;\r\n        }\r\n\r\n        .order-number {\r\n            font-size: 5em;\r\n            color: #4CAF50;\r\n            margin: 30px 0;\r\n            font-weight: bold;\r\n        }\r\n\r\n        .success-message {\r\n            font-size: 2em;\r\n            margin-bottom: 50px;\r\n        }\r\n    </style>\r\n</head>\r\n<body>\r\n    <div id=\"screensaver\" onclick=\"startApplication()\">\r\n        НАЖМИТЕ ДЛЯ РАБОТЫ\r\n        <div style=\"font-size: 0.5em; margin-top: 20px;\">Коснитесь экрана для начала работы</div>\r\n    </div>\r\n\r\n    <div id=\"app\">\r\n        <!-- ШАГ 1: ВЫБОР ИЗДЕЛИЯ -->\r\n        {% include 'terminal/step1_products.html' %}\r\n\r\n        <!-- ШАГ 2: ВЫБОР МОДЕЛИ -->\r\n        {% include 'terminal/step2_models.html' %}\r\n\r\n        <!-- ШАГ 3: ВЫБОР РАЗМЕРА -->\r\n        {% include 'terminal/step3_sizes.html' %}\r\n\r\n        <!-- ШАГ 4: ВЫБОР ПРИНТА -->\r\n        {% include 'terminal/step4_prints.html' %}\r\n\r\n        <!-- ШАГ 5: ПОДТВЕРЖДЕНИЕ -->\r\n        {% include 'terminal/step5_confirmation.html' %}\r\n\r\n        <!-- НАВИГАЦИЯ -->\r\n        {% include 'terminal/navigation.html' %}\r\n    </div>\r\n\r\n    <!-- ЭКРАН УСПЕШНОГО ЗАКАЗА -->\r\n    {% include 'terminal/success_screen.html' %}\r\n\r\n    <script>\r\n        // JavaScript код остается тем же\r\n        let currentStep = 1;\r\n        let selectedProduct = null;\r\n        let selectedModel = null;\r\n        let selectedSize = null;\r\n        let selectedPrint = null;\r\n\r\n        function startApplication() {\r\n            console.log('Start application called');\r\n            document.getElementById('screensaver').style.display = 'none';\r\n            document.getElementById('app').style.display = 'flex';\r\n            showStep(1);\r\n        }\r\n\r\n        function showStep(step) {\r\n            console.log('Show step:', step);\r\n            document.querySelectorAll('.step-container').forEach(container => {\r\n                container.style.display = 'none';\r\n            });\r\n\r\n            const stepElement = document.getElementById(`step${step}`);\r\n            if (stepElement) {\r\n                stepElement.style.display = 'flex';\r\n            }\r\n\r\n            currentStep = step;\r\n            updateNavigation();\r\n        }\r\n\r\n        function updateNavigation() {\r\n            const prevBtn = document.getElementById('prevBtn');\r\n            const nextBtn = document.getElementById('nextBtn');\r\n            const confirmBtn = document.getElementById('confirmBtn');\r\n\r\n            prevBtn.disabled = currentStep === 1;\r\n            nextBtn.style.display = currentStep === 5 ? 'none' : 'block';\r\n            confirmBtn.style.display = currentStep === 5 ? 'block' : 'none';\r\n        }\r\n\r\n        function selectProduct(productId, productName) {\r\n            selectedProduct = { id: productId, name: productName };\r\n            updateSelection('productsContainer', productName);\r\n            nextStep();\r\n        }\r\n\r\n        function selectModel(modelId, modelName) {\r\n            selectedModel = { id: modelId, name: modelName };\r\n            updateSelection('modelsContainer', modelName);\r\n            nextStep();\r\n        }\r\n\r\n        function selectSize(size) {\r\n            selectedSize = size;\r\n            updateSelection('sizesContainer', size);\r\n            nextStep();\r\n        }\r\n\r\n        function selectPrint(printType) {\r\n            selectedPrint = printType;\r\n            updateSelection('printsGallery', printType);\r\n            updateProductInfo();\r\n        }\r\n\r\n        function updateSelection(containerId, selectedValue) {\r\n            const container = document.getElementById(containerId);\r\n            container.querySelectorAll('.swipe-item, .print-option').forEach(item => {\r\n                item.classList.remove('selected');\r\n            });\r\n\r\n            const elements = container.querySelectorAll('.swipe-item, .print-option');\r\n            elements.forEach(element => {\r\n                if (element.textContent.includes(selectedValue)) {\r\n                    element.classList.add('selected');\r\n                }\r\n            });\r\n        }\r\n\r\n        function updateProductInfo() {\r\n            const infoText = `Модель: ${selectedModel?.name || '-'} | Размер: ${selectedSize || '-'}`;\r\n            document.getElementById('productInfoText').textContent = infoText;\r\n        }\r\n\r\n        function nextStep() {\r\n            if (currentStep < 5) {\r\n                showStep(currentStep + 1);\r\n                if (currentStep === 4) {\r\n                    updateProductInfo();\r\n                }\r\n                if (currentStep === 5) {\r\n                    updateOrderSummary();\r\n                }\r\n            }\r\n        }\r\n\r\n        function previousStep() {\r\n            if (currentStep > 1) {\r\n                showStep(currentStep - 1);\r\n            }\r\n        }\r\n\r\n        function updateOrderSummary() {\r\n            document.getElementById('summaryProduct').textContent = selectedProduct?.name || '-';\r\n            document.getElementById('summaryModel').textContent = selectedModel?.name || '-';\r\n            document.getElementById('summarySize').textContent = selectedSize || '-';\r\n            document.getElementById('summaryPrint').textContent = selectedPrint || '-';\r\n        }\r\n\r\n        function submitOrder() {\r\n            const name = document.getElementById('customerName').value;\r\n            const phone = document.getElementById('customerPhone').value;\r\n\r\n            if (!name || !phone) {\r\n                alert('Пожалуйста, заполните все поля');\r\n                return;\r\n            }\r\n\r\n            const orderNumber = 'ORD' + Math.random().toString().substr(2, 6);\r\n            document.getElementById('orderNumberDisplay').textContent = orderNumber;\r\n            document.getElementById('successScreen').style.display = 'flex';\r\n        }\r\n\r\n        function resetTerminal() {\r\n            document.getElementById('successScreen').style.display = 'none';\r\n            document.getElementById('customerName').value = '';\r\n            document.getElementById('customerPhone').value = '';\r\n            selectedProduct = null;\r\n            selectedModel = null;\r\n            selectedSize = null;\r\n            selectedPrint = null;\r\n            document.querySelectorAll('.selected').forEach(item => {\r\n                item.classList.remove('selected');\r\n            });\r\n            showStep(1);\r\n        }\r\n    </script>\r\n</body>\r\n</html>
